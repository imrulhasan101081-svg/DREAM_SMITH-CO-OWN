# MongoDB Database Connection
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dreamsmith?retryWrites=true&w=majority"

# NextAuth Configuration
# In Vercel, NEXTAUTH_URL is optional, but required in production elsewhere.
NEXTAUTH_URL="https://your-domain.com"
NEXTAUTH_SECRET="generate-a-strong-32-character-secret-here"

# Google OAuth for Super Admin
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# AES-256 Encryption Key (Must be exactly 32 bytes/characters)
ENCRYPTION_KEY="replace-this-with-a-32-byte-key!"

# Seed Protection — required to call /api/seed outside local development
# (e.g. on Vercel preview/production). Generate a random string.
SEED_SECRET="generate-a-random-secret-here"
